# Deny by default: only the scripts/ tree (and the pinned mlm extras for the
# core image) is ever COPY'd into an image (see service/Dockerfile*), so send
# nothing else in the build context.
*
!scripts/
!scripts/**
!requirements-local.txt

# Never ship build/runtime junk even though it sits under scripts/
**/__pycache__/
*.pyc
